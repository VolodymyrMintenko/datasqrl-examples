  AVG(metric_050) AS avg_metric_050,
  MAX(metric_050) AS max_metric_050,
  AVG(metric_051) AS avg_metric_051,
  MAX(metric_051) AS max_metric_051,
  AVG(metric_052) AS avg_metric_052,
  MAX(metric_052) AS max_metric_052,
  AVG(metric_053) AS avg_metric_053,
  MAX(metric_053) AS max_metric_053,
  AVG(metric_054) AS avg_metric_054,
  MAX(metric_054) AS max_metric_054,
  AVG(metric_055) AS avg_metric_055,
  MAX(metric_055) AS max_metric_055,
  AVG(metric_056) AS avg_metric_056,
  MAX(metric_056) AS max_metric_056,
  AVG(metric_057) AS avg_metric_057,
  MAX(metric_057) AS max_metric_057,
  AVG(metric_058) AS avg_metric_058,
  MAX(metric_058) AS max_metric_058,
  AVG(metric_059) AS avg_metric_059,
