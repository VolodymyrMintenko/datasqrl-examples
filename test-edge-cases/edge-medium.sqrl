    WHEN metric_039 > 600.0 THEN metric_039 * 1.70
    WHEN metric_039 > 500.0 THEN metric_039 * 1.60
    WHEN metric_039 > 400.0 THEN metric_039 * 1.50
    WHEN metric_039 > 300.0 THEN metric_039 * 1.40
    WHEN metric_039 > 200.0 THEN metric_039 * 1.30
