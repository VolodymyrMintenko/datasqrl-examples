    WHEN metric_040 > 200.0 THEN metric_040 * 1.30
    WHEN metric_040 > 100.0 THEN metric_040 * 1.20
    WHEN metric_040 > 0.0 THEN metric_040 * 1.10
    ELSE metric_040
  END) AS sum_metric_040,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Raw02, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

