    WHEN metric_039 > 900.0 THEN metric_039 * 2.00
    WHEN metric_039 > 800.0 THEN metric_039 * 1.90
    WHEN metric_039 > 700.0 THEN metric_039 * 1.80
    WHEN metric_039 > 600.0 THEN metric_039 * 1.70
