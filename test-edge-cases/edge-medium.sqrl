_Enriched01 := SELECT
  eventId,
  deviceId,
  region,
  category,
  dim_01,
  dim_02,
  dim_03,
  dim_04,
  dim_05,
  dim_06,
  dim_07,
  dim_08,
  metric_001 * 1.0 + 1.0 AS metric_001,
  metric_002 * 1.0 + 2.0 AS metric_002,
  metric_003 * 1.0 + 3.0 AS metric_003,
  metric_004 * 1.0 + 4.0 AS metric_004,
  metric_005 * 1.0 + 5.0 AS metric_005,
  metric_006 * 1.0 + 6.0 AS metric_006,
  metric_007 * 1.0 + 7.0 AS metric_007,
  metric_008 * 1.0 + 8.0 AS metric_008,
  metric_009 * 1.0 + 9.0 AS metric_009,
