/** Weighted 30 second totals for domain 02, keyed by region. */
/*+primary_key(region, window_end) */
Metrics02 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(CASE
    WHEN metric_001 > 900.0 THEN metric_001 * 2.00
    WHEN metric_001 > 800.0 THEN metric_001 * 1.90
    WHEN metric_001 > 700.0 THEN metric_001 * 1.80
    WHEN metric_001 > 600.0 THEN metric_001 * 1.70
    WHEN metric_001 > 500.0 THEN metric_001 * 1.60
    WHEN metric_001 > 400.0 THEN metric_001 * 1.50
    WHEN metric_001 > 300.0 THEN metric_001 * 1.40
    WHEN metric_001 > 200.0 THEN metric_001 * 1.30
    WHEN metric_001 > 100.0 THEN metric_001 * 1.20
    WHEN metric_001 > 0.0 THEN metric_001 * 1.10
    ELSE metric_001
  END) AS sum_metric_001,
  SUM(CASE
    WHEN metric_002 > 900.0 THEN metric_002 * 2.00
    WHEN metric_002 > 800.0 THEN metric_002 * 1.90
    WHEN metric_002 > 700.0 THEN metric_002 * 1.80
    WHEN metric_002 > 600.0 THEN metric_002 * 1.70
    WHEN metric_002 > 500.0 THEN metric_002 * 1.60
    WHEN metric_002 > 400.0 THEN metric_002 * 1.50
    WHEN metric_002 > 300.0 THEN metric_002 * 1.40
