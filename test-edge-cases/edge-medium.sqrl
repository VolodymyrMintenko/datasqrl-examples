  AVG(metric_040) AS avg_metric_040,
  MAX(metric_040) AS max_metric_040,
  AVG(metric_041) AS avg_metric_041,
  MAX(metric_041) AS max_metric_041,
  AVG(metric_042) AS avg_metric_042,
  MAX(metric_042) AS max_metric_042,
  AVG(metric_043) AS avg_metric_043,
  MAX(metric_043) AS max_metric_043,
  AVG(metric_044) AS avg_metric_044,
  MAX(metric_044) AS max_metric_044,
  AVG(metric_045) AS avg_metric_045,
  MAX(metric_045) AS max_metric_045,
  AVG(metric_046) AS avg_metric_046,
  MAX(metric_046) AS max_metric_046,
  AVG(metric_047) AS avg_metric_047,
  MAX(metric_047) AS max_metric_047,
  AVG(metric_048) AS avg_metric_048,
  MAX(metric_048) AS max_metric_048,
  AVG(metric_049) AS avg_metric_049,
  MAX(metric_049) AS max_metric_049,
  AVG(metric_050) AS avg_metric_050,
  MAX(metric_050) AS max_metric_050,
  AVG(metric_051) AS avg_metric_051,
  MAX(metric_051) AS max_metric_051,
  AVG(metric_052) AS avg_metric_052,
  MAX(metric_052) AS max_metric_052,
  AVG(metric_053) AS avg_metric_053,
  MAX(metric_053) AS max_metric_053,
  AVG(metric_054) AS avg_metric_054,
  MAX(metric_054) AS max_metric_054,
  AVG(metric_055) AS avg_metric_055,
  MAX(metric_055) AS max_metric_055,
  AVG(metric_056) AS avg_metric_056,
  MAX(metric_056) AS max_metric_056,
  AVG(metric_057) AS avg_metric_057,
  MAX(metric_057) AS max_metric_057,
  AVG(metric_058) AS avg_metric_058,
  MAX(metric_058) AS max_metric_058,
  AVG(metric_059) AS avg_metric_059,
  MAX(metric_059) AS max_metric_059,
  AVG(metric_060) AS avg_metric_060,
  MAX(metric_060) AS max_metric_060
FROM TABLE(
  TUMBLE(TABLE _Enriched01, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/** Narrow projection of the wide detail aggregate for domain 01. */
/*+primary_key(region, window_end) */
Summary01 := SELECT
  region,
  window_end,
  window_time,
  avg_metric_001,
  max_metric_001,
  avg_metric_002,
  max_metric_002
FROM _Detail01;

_Rolling01 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched01, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 01. */
/*+query_by_all(deviceId) */
Latest01 := DISTINCT _Rolling01 ON deviceId ORDER BY window_time DESC;

_Alerts01 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics01 WHERE sum_metric_001 > 100000.0;

EXPORT _Alerts01 TO logger.alerts01;

/* ============================================================
   Domain 02
   ============================================================ */

