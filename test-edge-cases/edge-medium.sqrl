  MAX(metric_027) AS max_metric_027,
  AVG(metric_028) AS avg_metric_028,
  MAX(metric_028) AS max_metric_028,
  AVG(metric_029) AS avg_metric_029,
  MAX(metric_029) AS max_metric_029,
  AVG(metric_030) AS avg_metric_030,
  MAX(metric_030) AS max_metric_030,
  AVG(metric_031) AS avg_metric_031,
  MAX(metric_031) AS max_metric_031,
  AVG(metric_032) AS avg_metric_032,
  MAX(metric_032) AS max_metric_032,
  AVG(metric_033) AS avg_metric_033,
  MAX(metric_033) AS max_metric_033,
  AVG(metric_034) AS avg_metric_034,
  MAX(metric_034) AS max_metric_034,
