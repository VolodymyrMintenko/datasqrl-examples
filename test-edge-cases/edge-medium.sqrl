  metric_012 * 1.0 + 12.0 AS metric_012,
  metric_013 * 1.0 + 13.0 AS metric_013,
  metric_014 * 1.0 + 14.0 AS metric_014,
  metric_015 * 1.0 + 15.0 AS metric_015,
  metric_016 * 1.0 + 16.0 AS metric_016,
  metric_017 * 1.0 + 0.0 AS metric_017,
  metric_018 * 1.0 + 1.0 AS metric_018,
