  AVG(metric_051) AS avg_metric_051,
  MAX(metric_051) AS max_metric_051,
  AVG(metric_052) AS avg_metric_052,
  MAX(metric_052) AS max_metric_052,
  AVG(metric_053) AS avg_metric_053,
  MAX(metric_053) AS max_metric_053,
  AVG(metric_054) AS avg_metric_054,
  MAX(metric_054) AS max_metric_054,
  AVG(metric_055) AS avg_metric_055,
  MAX(metric_055) AS max_metric_055,
  AVG(metric_056) AS avg_metric_056,
  MAX(metric_056) AS max_metric_056,
  AVG(metric_057) AS avg_metric_057,
  MAX(metric_057) AS max_metric_057,
  AVG(metric_058) AS avg_metric_058,
  MAX(metric_058) AS max_metric_058,
  AVG(metric_059) AS avg_metric_059,
  MAX(metric_059) AS max_metric_059,
  AVG(metric_060) AS avg_metric_060,
  MAX(metric_060) AS max_metric_060
FROM TABLE(
  TUMBLE(TABLE _Enriched05, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/** Narrow projection of the wide detail aggregate for domain 05. */
/*+primary_key(region, window_end) */
Summary05 := SELECT
  region,
  window_end,
  window_time,
  avg_metric_001,
  max_metric_001,
  avg_metric_002,
  max_metric_002
FROM _Detail05;

_Rolling05 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched05, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 05. */
/*+query_by_all(deviceId) */
Latest05 := DISTINCT _Rolling05 ON deviceId ORDER BY window_time DESC;

_Alerts05 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics05 WHERE sum_metric_001 > 100000.0;

