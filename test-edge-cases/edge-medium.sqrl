/** Weighted 30 second totals for domain 03, keyed by region. */
/*+primary_key(region, window_end) */
Metrics03 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(CASE
    WHEN metric_001 > 900.0 THEN metric_001 * 2.00
    WHEN metric_001 > 800.0 THEN metric_001 * 1.90
    WHEN metric_001 > 700.0 THEN metric_001 * 1.80
    WHEN metric_001 > 600.0 THEN metric_001 * 1.70
    WHEN metric_001 > 500.0 THEN metric_001 * 1.60
    WHEN metric_001 > 400.0 THEN metric_001 * 1.50
    WHEN metric_001 > 300.0 THEN metric_001 * 1.40
    WHEN metric_001 > 200.0 THEN metric_001 * 1.30
