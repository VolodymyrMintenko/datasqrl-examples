FROM TABLE(
  TUMBLE(TABLE _Enriched03, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/*+primary_key(region, window_end) */
_Detail03 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  AVG(metric_001) AS avg_metric_001,
  MAX(metric_001) AS max_metric_001,
  AVG(metric_002) AS avg_metric_002,
  MAX(metric_002) AS max_metric_002,
