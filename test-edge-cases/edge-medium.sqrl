    WHEN metric_038 > 600.0 THEN metric_038 * 1.70
    WHEN metric_038 > 500.0 THEN metric_038 * 1.60
    WHEN metric_038 > 400.0 THEN metric_038 * 1.50
    WHEN metric_038 > 300.0 THEN metric_038 * 1.40
    WHEN metric_038 > 200.0 THEN metric_038 * 1.30
    WHEN metric_038 > 100.0 THEN metric_038 * 1.20
    WHEN metric_038 > 0.0 THEN metric_038 * 1.10
    ELSE metric_038
  END) AS sum_metric_038,
  SUM(CASE
    WHEN metric_039 > 900.0 THEN metric_039 * 2.00
    WHEN metric_039 > 800.0 THEN metric_039 * 1.90
    WHEN metric_039 > 700.0 THEN metric_039 * 1.80
    WHEN metric_039 > 600.0 THEN metric_039 * 1.70
    WHEN metric_039 > 500.0 THEN metric_039 * 1.60
    WHEN metric_039 > 400.0 THEN metric_039 * 1.50
    WHEN metric_039 > 300.0 THEN metric_039 * 1.40
    WHEN metric_039 > 200.0 THEN metric_039 * 1.30
    WHEN metric_039 > 100.0 THEN metric_039 * 1.20
    WHEN metric_039 > 0.0 THEN metric_039 * 1.10
    ELSE metric_039
  END) AS sum_metric_039,
  SUM(CASE
    WHEN metric_040 > 900.0 THEN metric_040 * 2.00
    WHEN metric_040 > 800.0 THEN metric_040 * 1.90
    WHEN metric_040 > 700.0 THEN metric_040 * 1.80
    WHEN metric_040 > 600.0 THEN metric_040 * 1.70
    WHEN metric_040 > 500.0 THEN metric_040 * 1.60
    WHEN metric_040 > 400.0 THEN metric_040 * 1.50
    WHEN metric_040 > 300.0 THEN metric_040 * 1.40
    WHEN metric_040 > 200.0 THEN metric_040 * 1.30
    WHEN metric_040 > 100.0 THEN metric_040 * 1.20
    WHEN metric_040 > 0.0 THEN metric_040 * 1.10
    ELSE metric_040
  END) AS sum_metric_040,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Raw04, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/* ============================================================
   Query functions and subscription
   ============================================================ */

/** Returns the 30 second totals of domain 01 for a region and time range. */
MetricsByRegion(region STRING NOT NULL, fromTime TIMESTAMP NOT NULL, toTime TIMESTAMP NOT NULL) :=
SELECT * FROM Metrics01
WHERE region = :region AND :fromTime <= window_start AND :toTime > window_end
ORDER BY window_end DESC;

/** Returns the latest rolling maxima for one device of domain 01. */
LatestByDevice(deviceId STRING NOT NULL) :=
SELECT * FROM Latest01 WHERE deviceId = :deviceId;

/** The first domains side by side, one row per domain, region and window. */
/*+primary_key(domainId, region, window_end) */
RegionTotals :=
  SELECT '01' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics01
  UNION ALL
  SELECT '02' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics02
  UNION ALL
  SELECT '03' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics03
  UNION ALL
  SELECT '04' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics04;

/** Pushes alerts of domain 01 to subscribers. */
HighMetricAlert := SUBSCRIBE SELECT * FROM _Alerts01;
