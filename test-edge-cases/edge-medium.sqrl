  MAX(metric_021) AS max_metric_021,
  AVG(metric_022) AS avg_metric_022,
  MAX(metric_022) AS max_metric_022,
  AVG(metric_023) AS avg_metric_023,
  MAX(metric_023) AS max_metric_023,
  AVG(metric_024) AS avg_metric_024,
