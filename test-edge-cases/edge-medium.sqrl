  AVG(metric_043) AS avg_metric_043,
  MAX(metric_043) AS max_metric_043,
  AVG(metric_044) AS avg_metric_044,
  MAX(metric_044) AS max_metric_044,
  AVG(metric_045) AS avg_metric_045,
