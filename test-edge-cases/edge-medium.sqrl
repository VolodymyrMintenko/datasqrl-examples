_Enriched06 := SELECT
  eventId,
  deviceId,
  region,
  category,
  dim_01,
  dim_02,
  dim_03,
  dim_04,
  dim_05,
  dim_06,
  dim_07,
  dim_08,
  metric_001 * 1.0 + 1.0 AS metric_001,
  metric_002 * 1.0 + 2.0 AS metric_002,
  metric_003 * 1.0 + 3.0 AS metric_003,
  metric_004 * 1.0 + 4.0 AS metric_004,
  metric_005 * 1.0 + 5.0 AS metric_005,
  metric_006 * 1.0 + 6.0 AS metric_006,
  metric_007 * 1.0 + 7.0 AS metric_007,
  metric_008 * 1.0 + 8.0 AS metric_008,
  metric_009 * 1.0 + 9.0 AS metric_009,
  metric_010 * 1.0 + 10.0 AS metric_010,
  metric_011 * 1.0 + 11.0 AS metric_011,
  metric_012 * 1.0 + 12.0 AS metric_012,
  metric_013 * 1.0 + 13.0 AS metric_013,
  metric_014 * 1.0 + 14.0 AS metric_014,
  metric_015 * 1.0 + 15.0 AS metric_015,
  metric_016 * 1.0 + 16.0 AS metric_016,
  metric_017 * 1.0 + 0.0 AS metric_017,
  metric_018 * 1.0 + 1.0 AS metric_018,
  metric_019 * 1.0 + 2.0 AS metric_019,
  metric_020 * 1.0 + 3.0 AS metric_020,
  metric_021 * 1.0 + 4.0 AS metric_021,
  metric_022 * 1.0 + 5.0 AS metric_022,
  metric_023 * 1.0 + 6.0 AS metric_023,
  metric_024 * 1.0 + 7.0 AS metric_024,
  metric_025 * 1.0 + 8.0 AS metric_025,
  metric_026 * 1.0 + 9.0 AS metric_026,
  metric_027 * 1.0 + 10.0 AS metric_027,
  metric_028 * 1.0 + 11.0 AS metric_028,
  metric_029 * 1.0 + 12.0 AS metric_029,
  metric_030 * 1.0 + 13.0 AS metric_030,
  metric_031 * 1.0 + 14.0 AS metric_031,
  metric_032 * 1.0 + 15.0 AS metric_032,
  metric_033 * 1.0 + 16.0 AS metric_033,
  metric_034 * 1.0 + 0.0 AS metric_034,
  metric_035 * 1.0 + 1.0 AS metric_035,
  metric_036 * 1.0 + 2.0 AS metric_036,
  metric_037 * 1.0 + 3.0 AS metric_037,
  metric_038 * 1.0 + 4.0 AS metric_038,
  metric_039 * 1.0 + 5.0 AS metric_039,
  metric_040 * 1.0 + 6.0 AS metric_040,
  metric_041 * 1.0 + 7.0 AS metric_041,
  metric_042 * 1.0 + 8.0 AS metric_042,
  metric_043 * 1.0 + 9.0 AS metric_043,
  metric_044 * 1.0 + 10.0 AS metric_044,
  metric_045 * 1.0 + 11.0 AS metric_045,
  metric_046 * 1.0 + 12.0 AS metric_046,
  metric_047 * 1.0 + 13.0 AS metric_047,
  metric_048 * 1.0 + 14.0 AS metric_048,
  metric_049 * 1.0 + 15.0 AS metric_049,
  metric_050 * 1.0 + 16.0 AS metric_050,
  metric_051 * 1.0 + 0.0 AS metric_051,
  metric_052 * 1.0 + 1.0 AS metric_052,
  metric_053 * 1.0 + 2.0 AS metric_053,
  metric_054 * 1.0 + 3.0 AS metric_054,
  metric_055 * 1.0 + 4.0 AS metric_055,
  metric_056 * 1.0 + 5.0 AS metric_056,
  metric_057 * 1.0 + 6.0 AS metric_057,
  metric_058 * 1.0 + 7.0 AS metric_058,
  metric_059 * 1.0 + 8.0 AS metric_059,
  metric_060 * 1.0 + 9.0 AS metric_060,
  event_time
FROM _Raw06;

/** Tumbling 30 second totals for domain 06, keyed by region. */
/*+primary_key(region, window_end) */
Metrics06 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(metric_001) AS sum_metric_001,
  SUM(metric_002) AS sum_metric_002,
  SUM(metric_003) AS sum_metric_003,
  SUM(metric_004) AS sum_metric_004,
  SUM(metric_005) AS sum_metric_005,
  SUM(metric_006) AS sum_metric_006,
  SUM(metric_007) AS sum_metric_007,
  SUM(metric_008) AS sum_metric_008,
  SUM(metric_009) AS sum_metric_009,
  SUM(metric_010) AS sum_metric_010,
  SUM(metric_011) AS sum_metric_011,
  SUM(metric_012) AS sum_metric_012,
  SUM(metric_013) AS sum_metric_013,
  SUM(metric_014) AS sum_metric_014,
  SUM(metric_015) AS sum_metric_015,
  SUM(metric_016) AS sum_metric_016,
  SUM(metric_017) AS sum_metric_017,
  SUM(metric_018) AS sum_metric_018,
  SUM(metric_019) AS sum_metric_019,
  SUM(metric_020) AS sum_metric_020,
  SUM(metric_021) AS sum_metric_021,
  SUM(metric_022) AS sum_metric_022,
  SUM(metric_023) AS sum_metric_023,
  SUM(metric_024) AS sum_metric_024,
  SUM(metric_025) AS sum_metric_025,
  SUM(metric_026) AS sum_metric_026,
  SUM(metric_027) AS sum_metric_027,
  SUM(metric_028) AS sum_metric_028,
  SUM(metric_029) AS sum_metric_029,
  SUM(metric_030) AS sum_metric_030,
  SUM(metric_031) AS sum_metric_031,
  SUM(metric_032) AS sum_metric_032,
  SUM(metric_033) AS sum_metric_033,
  SUM(metric_034) AS sum_metric_034,
  SUM(metric_035) AS sum_metric_035,
  SUM(metric_036) AS sum_metric_036,
  SUM(metric_037) AS sum_metric_037,
  SUM(metric_038) AS sum_metric_038,
  SUM(metric_039) AS sum_metric_039,
  SUM(metric_040) AS sum_metric_040,
  SUM(metric_041) AS sum_metric_041,
  SUM(metric_042) AS sum_metric_042,
  SUM(metric_043) AS sum_metric_043,
  SUM(metric_044) AS sum_metric_044,
  SUM(metric_045) AS sum_metric_045,
  SUM(metric_046) AS sum_metric_046,
  SUM(metric_047) AS sum_metric_047,
  SUM(metric_048) AS sum_metric_048,
  SUM(metric_049) AS sum_metric_049,
  SUM(metric_050) AS sum_metric_050,
  SUM(metric_051) AS sum_metric_051,
  SUM(metric_052) AS sum_metric_052,
  SUM(metric_053) AS sum_metric_053,
  SUM(metric_054) AS sum_metric_054,
  SUM(metric_055) AS sum_metric_055,
  SUM(metric_056) AS sum_metric_056,
  SUM(metric_057) AS sum_metric_057,
  SUM(metric_058) AS sum_metric_058,
  SUM(metric_059) AS sum_metric_059,
  SUM(metric_060) AS sum_metric_060,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Enriched06, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/*+primary_key(region, window_end) */
_Detail06 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  AVG(metric_001) AS avg_metric_001,
  MAX(metric_001) AS max_metric_001,
  AVG(metric_002) AS avg_metric_002,
  MAX(metric_002) AS max_metric_002,
  AVG(metric_003) AS avg_metric_003,
  MAX(metric_003) AS max_metric_003,
