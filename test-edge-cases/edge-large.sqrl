_Enriched02 := SELECT
  eventId,
  deviceId,
  region,
  category,
  dim_01,
  dim_02,
  dim_03,
  dim_04,
  dim_05,
  dim_06,
  dim_07,
  dim_08,
  metric_001 * 1.0 + 1.0 AS metric_001,
