  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched33, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 33. */
/*+query_by_all(deviceId) */
Latest33 := DISTINCT _Rolling33 ON deviceId ORDER BY window_time DESC;

_Alerts33 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics33 WHERE sum_metric_001 > 100000.0;

/* ============================================================
   Domain 34
   ============================================================ */

