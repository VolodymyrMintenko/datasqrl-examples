/** Tumbling 30 second totals for domain 20, keyed by region. */
/*+primary_key(region, window_end) */
Metrics20 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(metric_001) AS sum_metric_001,
  SUM(metric_002) AS sum_metric_002,
