    WHEN metric_155 > 700.0 THEN metric_155 * 1.80
    WHEN metric_155 > 600.0 THEN metric_155 * 1.70
    WHEN metric_155 > 500.0 THEN metric_155 * 1.60
    WHEN metric_155 > 400.0 THEN metric_155 * 1.50
    WHEN metric_155 > 300.0 THEN metric_155 * 1.40
    WHEN metric_155 > 200.0 THEN metric_155 * 1.30
    WHEN metric_155 > 100.0 THEN metric_155 * 1.20
    WHEN metric_155 > 0.0 THEN metric_155 * 1.10
    ELSE metric_155
  END) AS sum_metric_155,
  SUM(CASE
    WHEN metric_156 > 900.0 THEN metric_156 * 2.00
    WHEN metric_156 > 800.0 THEN metric_156 * 1.90
    WHEN metric_156 > 700.0 THEN metric_156 * 1.80
    WHEN metric_156 > 600.0 THEN metric_156 * 1.70
    WHEN metric_156 > 500.0 THEN metric_156 * 1.60
    WHEN metric_156 > 400.0 THEN metric_156 * 1.50
    WHEN metric_156 > 300.0 THEN metric_156 * 1.40
    WHEN metric_156 > 200.0 THEN metric_156 * 1.30
    WHEN metric_156 > 100.0 THEN metric_156 * 1.20
    WHEN metric_156 > 0.0 THEN metric_156 * 1.10
    ELSE metric_156
  END) AS sum_metric_156,
  SUM(CASE
    WHEN metric_157 > 900.0 THEN metric_157 * 2.00
    WHEN metric_157 > 800.0 THEN metric_157 * 1.90
    WHEN metric_157 > 700.0 THEN metric_157 * 1.80
    WHEN metric_157 > 600.0 THEN metric_157 * 1.70
    WHEN metric_157 > 500.0 THEN metric_157 * 1.60
    WHEN metric_157 > 400.0 THEN metric_157 * 1.50
    WHEN metric_157 > 300.0 THEN metric_157 * 1.40
    WHEN metric_157 > 200.0 THEN metric_157 * 1.30
    WHEN metric_157 > 100.0 THEN metric_157 * 1.20
    WHEN metric_157 > 0.0 THEN metric_157 * 1.10
    ELSE metric_157
  END) AS sum_metric_157,
  SUM(CASE
    WHEN metric_158 > 900.0 THEN metric_158 * 2.00
    WHEN metric_158 > 800.0 THEN metric_158 * 1.90
    WHEN metric_158 > 700.0 THEN metric_158 * 1.80
    WHEN metric_158 > 600.0 THEN metric_158 * 1.70
    WHEN metric_158 > 500.0 THEN metric_158 * 1.60
    WHEN metric_158 > 400.0 THEN metric_158 * 1.50
    WHEN metric_158 > 300.0 THEN metric_158 * 1.40
    WHEN metric_158 > 200.0 THEN metric_158 * 1.30
    WHEN metric_158 > 100.0 THEN metric_158 * 1.20
    WHEN metric_158 > 0.0 THEN metric_158 * 1.10
    ELSE metric_158
  END) AS sum_metric_158,
  SUM(CASE
    WHEN metric_159 > 900.0 THEN metric_159 * 2.00
    WHEN metric_159 > 800.0 THEN metric_159 * 1.90
    WHEN metric_159 > 700.0 THEN metric_159 * 1.80
    WHEN metric_159 > 600.0 THEN metric_159 * 1.70
    WHEN metric_159 > 500.0 THEN metric_159 * 1.60
    WHEN metric_159 > 400.0 THEN metric_159 * 1.50
    WHEN metric_159 > 300.0 THEN metric_159 * 1.40
    WHEN metric_159 > 200.0 THEN metric_159 * 1.30
    WHEN metric_159 > 100.0 THEN metric_159 * 1.20
    WHEN metric_159 > 0.0 THEN metric_159 * 1.10
    ELSE metric_159
  END) AS sum_metric_159,
  SUM(CASE
    WHEN metric_160 > 900.0 THEN metric_160 * 2.00
    WHEN metric_160 > 800.0 THEN metric_160 * 1.90
    WHEN metric_160 > 700.0 THEN metric_160 * 1.80
    WHEN metric_160 > 600.0 THEN metric_160 * 1.70
    WHEN metric_160 > 500.0 THEN metric_160 * 1.60
    WHEN metric_160 > 400.0 THEN metric_160 * 1.50
    WHEN metric_160 > 300.0 THEN metric_160 * 1.40
    WHEN metric_160 > 200.0 THEN metric_160 * 1.30
    WHEN metric_160 > 100.0 THEN metric_160 * 1.20
    WHEN metric_160 > 0.0 THEN metric_160 * 1.10
    ELSE metric_160
  END) AS sum_metric_160,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Raw08, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

