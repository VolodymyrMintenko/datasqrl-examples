  MAX(metric_125) AS max_metric_125,
  AVG(metric_126) AS avg_metric_126,
  MAX(metric_126) AS max_metric_126,
  AVG(metric_127) AS avg_metric_127,
  MAX(metric_127) AS max_metric_127,
  AVG(metric_128) AS avg_metric_128,
  MAX(metric_128) AS max_metric_128,
  AVG(metric_129) AS avg_metric_129,
  MAX(metric_129) AS max_metric_129,
  AVG(metric_130) AS avg_metric_130,
  MAX(metric_130) AS max_metric_130,
  AVG(metric_131) AS avg_metric_131,
  MAX(metric_131) AS max_metric_131,
  AVG(metric_132) AS avg_metric_132,
  MAX(metric_132) AS max_metric_132,
  AVG(metric_133) AS avg_metric_133,
  MAX(metric_133) AS max_metric_133,
