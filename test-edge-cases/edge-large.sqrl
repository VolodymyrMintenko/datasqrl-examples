  MAX(metric_147) AS max_metric_147,
  AVG(metric_148) AS avg_metric_148,
  MAX(metric_148) AS max_metric_148,
  AVG(metric_149) AS avg_metric_149,
  MAX(metric_149) AS max_metric_149,
  AVG(metric_150) AS avg_metric_150,
  MAX(metric_150) AS max_metric_150,
  AVG(metric_151) AS avg_metric_151,
  MAX(metric_151) AS max_metric_151,
  AVG(metric_152) AS avg_metric_152,
  MAX(metric_152) AS max_metric_152,
  AVG(metric_153) AS avg_metric_153,
  MAX(metric_153) AS max_metric_153,
  AVG(metric_154) AS avg_metric_154,
  MAX(metric_154) AS max_metric_154,
  AVG(metric_155) AS avg_metric_155,
  MAX(metric_155) AS max_metric_155,
  AVG(metric_156) AS avg_metric_156,
  MAX(metric_156) AS max_metric_156
FROM TABLE(
  TUMBLE(TABLE _Enriched36, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/** Narrow projection of the wide detail aggregate for domain 36. */
/*+primary_key(region, window_end) */
Summary36 := SELECT
  region,
  window_end,
  window_time,
  avg_metric_001,
  max_metric_001,
  avg_metric_002,
  max_metric_002
FROM _Detail36;

_Rolling36 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched36, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 36. */
/*+query_by_all(deviceId) */
Latest36 := DISTINCT _Rolling36 ON deviceId ORDER BY window_time DESC;

_Alerts36 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics36 WHERE sum_metric_001 > 100000.0;

/* ============================================================
   Query functions and subscription
   ============================================================ */

/** Returns the 30 second totals of domain 01 for a region and time range. */
MetricsByRegion(region STRING NOT NULL, fromTime TIMESTAMP NOT NULL, toTime TIMESTAMP NOT NULL) :=
SELECT * FROM Metrics01
WHERE region = :region AND :fromTime <= window_start AND :toTime > window_end
ORDER BY window_end DESC;

/** Returns the latest rolling maxima for one device of domain 01. */
LatestByDevice(deviceId STRING NOT NULL) :=
SELECT * FROM Latest01 WHERE deviceId = :deviceId;

/** The first domains side by side, one row per domain, region and window. */
/*+primary_key(domainId, region, window_end) */
RegionTotals :=
  SELECT '01' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics01
  UNION ALL
  SELECT '02' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics02
  UNION ALL
  SELECT '03' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics03
  UNION ALL
  SELECT '04' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics04;

/** Pushes alerts of domain 01 to subscribers. */
HighMetricAlert := SUBSCRIBE SELECT * FROM _Alerts01;
