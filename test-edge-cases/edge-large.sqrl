/** Narrow projection of the wide detail aggregate for domain 20. */
/*+primary_key(region, window_end) */
Summary20 := SELECT
  region,
  window_end,
  window_time,
  avg_metric_001,
  max_metric_001,
  avg_metric_002,
  max_metric_002
FROM _Detail20;

_Rolling20 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched20, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 20. */
/*+query_by_all(deviceId) */
Latest20 := DISTINCT _Rolling20 ON deviceId ORDER BY window_time DESC;

_Alerts20 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics20 WHERE sum_metric_001 > 100000.0;

