/*
  edge-baseline.sqrl - generated by generate.py, do not edit by hand.

  1 data domains, 12 metric columns each, all fed by the
  datagen connector so the project runs without any external system.
  Used to test how the platform behaves on a large SQRL project.
*/

/* ============================================================
   Domain 01
   ============================================================ */

CREATE TABLE _Raw01 (
  eventId STRING NOT NULL,
  deviceId STRING NOT NULL,
  region STRING NOT NULL,
  category STRING NOT NULL,
  dim_01 STRING NOT NULL,
  dim_02 STRING NOT NULL,
  dim_03 STRING NOT NULL,
  dim_04 STRING NOT NULL,
  dim_05 STRING NOT NULL,
  dim_06 STRING NOT NULL,
  dim_07 STRING NOT NULL,
  dim_08 STRING NOT NULL,
  metric_001 DOUBLE NOT NULL,
  metric_002 DOUBLE NOT NULL,
  metric_003 DOUBLE NOT NULL,
  metric_004 DOUBLE NOT NULL,
  metric_005 DOUBLE NOT NULL,
  metric_006 DOUBLE NOT NULL,
  metric_007 DOUBLE NOT NULL,
  metric_008 DOUBLE NOT NULL,
  metric_009 DOUBLE NOT NULL,
  metric_010 DOUBLE NOT NULL,
  metric_011 DOUBLE NOT NULL,
  metric_012 DOUBLE NOT NULL,
  event_time AS NOW(),
  WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND
) WITH (
  'connector' = 'datagen',
  'rows-per-second' = '2',
  'fields.eventId.kind' = 'random',
  'fields.eventId.length' = '12',
  'fields.deviceId.kind' = 'random',
  'fields.deviceId.length' = '6',
  'fields.region.kind' = 'random',
  'fields.region.length' = '2',
  'fields.category.kind' = 'random',
  'fields.category.length' = '3',
  'fields.dim_01.kind' = 'random',
  'fields.dim_01.length' = '4',
  'fields.dim_02.kind' = 'random',
  'fields.dim_02.length' = '4',
  'fields.dim_03.kind' = 'random',
  'fields.dim_03.length' = '4',
  'fields.dim_04.kind' = 'random',
  'fields.dim_04.length' = '4',
  'fields.dim_05.kind' = 'random',
  'fields.dim_05.length' = '4',
  'fields.dim_06.kind' = 'random',
  'fields.dim_06.length' = '4',
  'fields.dim_07.kind' = 'random',
  'fields.dim_07.length' = '4',
  'fields.dim_08.kind' = 'random',
  'fields.dim_08.length' = '4',
  'fields.metric_001.kind' = 'random',
  'fields.metric_001.min' = '0.0',
  'fields.metric_001.max' = '1000.0',
  'fields.metric_002.kind' = 'random',
  'fields.metric_002.min' = '0.0',
  'fields.metric_002.max' = '1000.0',
  'fields.metric_003.kind' = 'random',
  'fields.metric_003.min' = '0.0',
  'fields.metric_003.max' = '1000.0',
  'fields.metric_004.kind' = 'random',
  'fields.metric_004.min' = '0.0',
  'fields.metric_004.max' = '1000.0',
  'fields.metric_005.kind' = 'random',
  'fields.metric_005.min' = '0.0',
  'fields.metric_005.max' = '1000.0',
  'fields.metric_006.kind' = 'random',
  'fields.metric_006.min' = '0.0',
  'fields.metric_006.max' = '1000.0',
  'fields.metric_007.kind' = 'random',
  'fields.metric_007.min' = '0.0',
  'fields.metric_007.max' = '1000.0',
  'fields.metric_008.kind' = 'random',
  'fields.metric_008.min' = '0.0',
  'fields.metric_008.max' = '1000.0',
  'fields.metric_009.kind' = 'random',
  'fields.metric_009.min' = '0.0',
  'fields.metric_009.max' = '1000.0',
  'fields.metric_010.kind' = 'random',
  'fields.metric_010.min' = '0.0',
  'fields.metric_010.max' = '1000.0',
  'fields.metric_011.kind' = 'random',
  'fields.metric_011.min' = '0.0',
  'fields.metric_011.max' = '1000.0',
  'fields.metric_012.kind' = 'random',
  'fields.metric_012.min' = '0.0',
  'fields.metric_012.max' = '1000.0'
);

_Enriched01 := SELECT
  eventId,
  deviceId,
  region,
  category,
  dim_01,
  dim_02,
  dim_03,
  dim_04,
  dim_05,
  dim_06,
  dim_07,
  dim_08,
  metric_001 * 1.0 + 1.0 AS metric_001,
  metric_002 * 1.0 + 2.0 AS metric_002,
  metric_003 * 1.0 + 3.0 AS metric_003,
  metric_004 * 1.0 + 4.0 AS metric_004,
  metric_005 * 1.0 + 5.0 AS metric_005,
  metric_006 * 1.0 + 6.0 AS metric_006,
  metric_007 * 1.0 + 7.0 AS metric_007,
  metric_008 * 1.0 + 8.0 AS metric_008,
  metric_009 * 1.0 + 9.0 AS metric_009,
  metric_010 * 1.0 + 10.0 AS metric_010,
  metric_011 * 1.0 + 11.0 AS metric_011,
  metric_012 * 1.0 + 12.0 AS metric_012,
  event_time
FROM _Raw01;

/** Tumbling 30 second totals for domain 01, keyed by region. */
/*+primary_key(region, window_end) */
Metrics01 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(metric_001) AS sum_metric_001,
  SUM(metric_002) AS sum_metric_002,
  SUM(metric_003) AS sum_metric_003,
  SUM(metric_004) AS sum_metric_004,
  SUM(metric_005) AS sum_metric_005,
  SUM(metric_006) AS sum_metric_006,
  SUM(metric_007) AS sum_metric_007,
  SUM(metric_008) AS sum_metric_008,
  SUM(metric_009) AS sum_metric_009,
  SUM(metric_010) AS sum_metric_010,
  SUM(metric_011) AS sum_metric_011,
  SUM(metric_012) AS sum_metric_012,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Enriched01, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/*+primary_key(region, window_end) */
_Detail01 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  AVG(metric_001) AS avg_metric_001,
  MAX(metric_001) AS max_metric_001,
  AVG(metric_002) AS avg_metric_002,
  MAX(metric_002) AS max_metric_002,
  AVG(metric_003) AS avg_metric_003,
  MAX(metric_003) AS max_metric_003,
  AVG(metric_004) AS avg_metric_004,
  MAX(metric_004) AS max_metric_004,
  AVG(metric_005) AS avg_metric_005,
  MAX(metric_005) AS max_metric_005,
  AVG(metric_006) AS avg_metric_006,
  MAX(metric_006) AS max_metric_006,
  AVG(metric_007) AS avg_metric_007,
  MAX(metric_007) AS max_metric_007,
  AVG(metric_008) AS avg_metric_008,
  MAX(metric_008) AS max_metric_008,
  AVG(metric_009) AS avg_metric_009,
  MAX(metric_009) AS max_metric_009,
  AVG(metric_010) AS avg_metric_010,
  MAX(metric_010) AS max_metric_010,
  AVG(metric_011) AS avg_metric_011,
  MAX(metric_011) AS max_metric_011,
  AVG(metric_012) AS avg_metric_012,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  TUMBLE(TABLE _Enriched01, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

/** Narrow projection of the wide detail aggregate for domain 01. */
/*+primary_key(region, window_end) */
Summary01 := SELECT
  region,
  window_end,
  window_time,
  avg_metric_001,
  max_metric_001,
  avg_metric_002,
  max_metric_002
FROM _Detail01;

_Rolling01 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Enriched01, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 01. */
/*+query_by_all(deviceId) */
Latest01 := DISTINCT _Rolling01 ON deviceId ORDER BY window_time DESC;

_Alerts01 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics01 WHERE sum_metric_001 > 100000.0;

EXPORT _Alerts01 TO logger.alerts01;

/* ============================================================
   Query functions and subscription
   ============================================================ */

/** Returns the 30 second totals of domain 01 for a region and time range. */
MetricsByRegion(region STRING NOT NULL, fromTime TIMESTAMP NOT NULL, toTime TIMESTAMP NOT NULL) :=
SELECT * FROM Metrics01
WHERE region = :region AND :fromTime <= window_start AND :toTime > window_end
ORDER BY window_end DESC;

/** Returns the latest rolling maxima for one device of domain 01. */
LatestByDevice(deviceId STRING NOT NULL) :=
SELECT * FROM Latest01 WHERE deviceId = :deviceId;

/** The first domains side by side, one row per domain, region and window. */
/*+primary_key(domainId, region, window_end) */
RegionTotals :=
  SELECT '01' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics01;

/** Pushes alerts of domain 01 to subscribers. */
HighMetricAlert := SUBSCRIBE SELECT * FROM _Alerts01;
