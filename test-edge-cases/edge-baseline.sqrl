/*
  edge-baseline.sqrl - generated by generate.py, do not edit by hand.

  1 data domains, 12 metric columns each, all fed by the
  datagen connector so the project runs without any external system.
  Used to test how the platform behaves on a large SQRL project.
*/

/* ============================================================
   Domain 01
   ============================================================ */

CREATE TABLE _Raw01 (
  eventId STRING NOT NULL,
  deviceId STRING NOT NULL,
  region STRING NOT NULL,
  category STRING NOT NULL,
  dim_01 STRING NOT NULL,
  dim_02 STRING NOT NULL,
  dim_03 STRING NOT NULL,
  dim_04 STRING NOT NULL,
  dim_05 STRING NOT NULL,
  dim_06 STRING NOT NULL,
  dim_07 STRING NOT NULL,
  dim_08 STRING NOT NULL,
  metric_001 DOUBLE NOT NULL,
  metric_002 DOUBLE NOT NULL,
  metric_003 DOUBLE NOT NULL,
  metric_004 DOUBLE NOT NULL,
  metric_005 DOUBLE NOT NULL,
  metric_006 DOUBLE NOT NULL,
  metric_007 DOUBLE NOT NULL,
  metric_008 DOUBLE NOT NULL,
  metric_009 DOUBLE NOT NULL,
  metric_010 DOUBLE NOT NULL,
  metric_011 DOUBLE NOT NULL,
  metric_012 DOUBLE NOT NULL,
  event_time AS NOW(),
  WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND
) WITH (
  'connector' = 'datagen',
  'rows-per-second' = '2',
  'fields.eventId.kind' = 'random',
  'fields.eventId.length' = '12',
  'fields.deviceId.kind' = 'random',
  'fields.deviceId.length' = '6',
  'fields.region.kind' = 'random',
  'fields.region.length' = '2',
  'fields.category.kind' = 'random',
  'fields.category.length' = '3',
  'fields.dim_01.kind' = 'random',
  'fields.dim_01.length' = '4',
  'fields.dim_02.kind' = 'random',
  'fields.dim_02.length' = '4',
  'fields.dim_03.kind' = 'random',
  'fields.dim_03.length' = '4',
  'fields.dim_04.kind' = 'random',
  'fields.dim_04.length' = '4',
  'fields.dim_05.kind' = 'random',
  'fields.dim_05.length' = '4',
  'fields.dim_06.kind' = 'random',
  'fields.dim_06.length' = '4',
  'fields.dim_07.kind' = 'random',
  'fields.dim_07.length' = '4',
  'fields.dim_08.kind' = 'random',
  'fields.dim_08.length' = '4',
  'fields.metric_001.kind' = 'random',
  'fields.metric_001.min' = '0.0',
  'fields.metric_001.max' = '1000.0',
  'fields.metric_002.kind' = 'random',
  'fields.metric_002.min' = '0.0',
  'fields.metric_002.max' = '1000.0',
  'fields.metric_003.kind' = 'random',
  'fields.metric_003.min' = '0.0',
  'fields.metric_003.max' = '1000.0',
  'fields.metric_004.kind' = 'random',
  'fields.metric_004.min' = '0.0',
  'fields.metric_004.max' = '1000.0',
  'fields.metric_005.kind' = 'random',
  'fields.metric_005.min' = '0.0',
  'fields.metric_005.max' = '1000.0',
  'fields.metric_006.kind' = 'random',
  'fields.metric_006.min' = '0.0',
  'fields.metric_006.max' = '1000.0',
  'fields.metric_007.kind' = 'random',
  'fields.metric_007.min' = '0.0',
  'fields.metric_007.max' = '1000.0',
  'fields.metric_008.kind' = 'random',
  'fields.metric_008.min' = '0.0',
  'fields.metric_008.max' = '1000.0',
  'fields.metric_009.kind' = 'random',
  'fields.metric_009.min' = '0.0',
  'fields.metric_009.max' = '1000.0',
  'fields.metric_010.kind' = 'random',
  'fields.metric_010.min' = '0.0',
  'fields.metric_010.max' = '1000.0',
  'fields.metric_011.kind' = 'random',
  'fields.metric_011.min' = '0.0',
  'fields.metric_011.max' = '1000.0',
  'fields.metric_012.kind' = 'random',
  'fields.metric_012.min' = '0.0',
  'fields.metric_012.max' = '1000.0'
);

/** Weighted 30 second totals for domain 01, keyed by region. */
/*+primary_key(region, window_end) */
Metrics01 := SELECT
  region,
  window_start,
  window_end,
  window_time,
  SUM(CASE
    WHEN metric_001 > 900.0 THEN metric_001 * 2.00
    WHEN metric_001 > 800.0 THEN metric_001 * 1.90
    WHEN metric_001 > 700.0 THEN metric_001 * 1.80
    WHEN metric_001 > 600.0 THEN metric_001 * 1.70
    WHEN metric_001 > 500.0 THEN metric_001 * 1.60
    WHEN metric_001 > 400.0 THEN metric_001 * 1.50
    WHEN metric_001 > 300.0 THEN metric_001 * 1.40
    WHEN metric_001 > 200.0 THEN metric_001 * 1.30
    WHEN metric_001 > 100.0 THEN metric_001 * 1.20
    WHEN metric_001 > 0.0 THEN metric_001 * 1.10
    ELSE metric_001
  END) AS sum_metric_001,
  SUM(CASE
    WHEN metric_002 > 900.0 THEN metric_002 * 2.00
    WHEN metric_002 > 800.0 THEN metric_002 * 1.90
    WHEN metric_002 > 700.0 THEN metric_002 * 1.80
    WHEN metric_002 > 600.0 THEN metric_002 * 1.70
    WHEN metric_002 > 500.0 THEN metric_002 * 1.60
    WHEN metric_002 > 400.0 THEN metric_002 * 1.50
    WHEN metric_002 > 300.0 THEN metric_002 * 1.40
    WHEN metric_002 > 200.0 THEN metric_002 * 1.30
    WHEN metric_002 > 100.0 THEN metric_002 * 1.20
    WHEN metric_002 > 0.0 THEN metric_002 * 1.10
    ELSE metric_002
  END) AS sum_metric_002,
  SUM(CASE
    WHEN metric_003 > 900.0 THEN metric_003 * 2.00
    WHEN metric_003 > 800.0 THEN metric_003 * 1.90
    WHEN metric_003 > 700.0 THEN metric_003 * 1.80
    WHEN metric_003 > 600.0 THEN metric_003 * 1.70
    WHEN metric_003 > 500.0 THEN metric_003 * 1.60
    WHEN metric_003 > 400.0 THEN metric_003 * 1.50
    WHEN metric_003 > 300.0 THEN metric_003 * 1.40
    WHEN metric_003 > 200.0 THEN metric_003 * 1.30
    WHEN metric_003 > 100.0 THEN metric_003 * 1.20
    WHEN metric_003 > 0.0 THEN metric_003 * 1.10
    ELSE metric_003
  END) AS sum_metric_003,
  SUM(CASE
    WHEN metric_004 > 900.0 THEN metric_004 * 2.00
    WHEN metric_004 > 800.0 THEN metric_004 * 1.90
    WHEN metric_004 > 700.0 THEN metric_004 * 1.80
    WHEN metric_004 > 600.0 THEN metric_004 * 1.70
    WHEN metric_004 > 500.0 THEN metric_004 * 1.60
    WHEN metric_004 > 400.0 THEN metric_004 * 1.50
    WHEN metric_004 > 300.0 THEN metric_004 * 1.40
    WHEN metric_004 > 200.0 THEN metric_004 * 1.30
    WHEN metric_004 > 100.0 THEN metric_004 * 1.20
    WHEN metric_004 > 0.0 THEN metric_004 * 1.10
    ELSE metric_004
  END) AS sum_metric_004,
  SUM(CASE
    WHEN metric_005 > 900.0 THEN metric_005 * 2.00
    WHEN metric_005 > 800.0 THEN metric_005 * 1.90
    WHEN metric_005 > 700.0 THEN metric_005 * 1.80
    WHEN metric_005 > 600.0 THEN metric_005 * 1.70
    WHEN metric_005 > 500.0 THEN metric_005 * 1.60
    WHEN metric_005 > 400.0 THEN metric_005 * 1.50
    WHEN metric_005 > 300.0 THEN metric_005 * 1.40
    WHEN metric_005 > 200.0 THEN metric_005 * 1.30
    WHEN metric_005 > 100.0 THEN metric_005 * 1.20
    WHEN metric_005 > 0.0 THEN metric_005 * 1.10
    ELSE metric_005
  END) AS sum_metric_005,
  SUM(CASE
    WHEN metric_006 > 900.0 THEN metric_006 * 2.00
    WHEN metric_006 > 800.0 THEN metric_006 * 1.90
    WHEN metric_006 > 700.0 THEN metric_006 * 1.80
    WHEN metric_006 > 600.0 THEN metric_006 * 1.70
    WHEN metric_006 > 500.0 THEN metric_006 * 1.60
    WHEN metric_006 > 400.0 THEN metric_006 * 1.50
    WHEN metric_006 > 300.0 THEN metric_006 * 1.40
    WHEN metric_006 > 200.0 THEN metric_006 * 1.30
    WHEN metric_006 > 100.0 THEN metric_006 * 1.20
    WHEN metric_006 > 0.0 THEN metric_006 * 1.10
    ELSE metric_006
  END) AS sum_metric_006,
  SUM(CASE
    WHEN metric_007 > 900.0 THEN metric_007 * 2.00
    WHEN metric_007 > 800.0 THEN metric_007 * 1.90
    WHEN metric_007 > 700.0 THEN metric_007 * 1.80
    WHEN metric_007 > 600.0 THEN metric_007 * 1.70
    WHEN metric_007 > 500.0 THEN metric_007 * 1.60
    WHEN metric_007 > 400.0 THEN metric_007 * 1.50
    WHEN metric_007 > 300.0 THEN metric_007 * 1.40
    WHEN metric_007 > 200.0 THEN metric_007 * 1.30
    WHEN metric_007 > 100.0 THEN metric_007 * 1.20
    WHEN metric_007 > 0.0 THEN metric_007 * 1.10
    ELSE metric_007
  END) AS sum_metric_007,
  SUM(CASE
    WHEN metric_008 > 900.0 THEN metric_008 * 2.00
    WHEN metric_008 > 800.0 THEN metric_008 * 1.90
    WHEN metric_008 > 700.0 THEN metric_008 * 1.80
    WHEN metric_008 > 600.0 THEN metric_008 * 1.70
    WHEN metric_008 > 500.0 THEN metric_008 * 1.60
    WHEN metric_008 > 400.0 THEN metric_008 * 1.50
    WHEN metric_008 > 300.0 THEN metric_008 * 1.40
    WHEN metric_008 > 200.0 THEN metric_008 * 1.30
    WHEN metric_008 > 100.0 THEN metric_008 * 1.20
    WHEN metric_008 > 0.0 THEN metric_008 * 1.10
    ELSE metric_008
  END) AS sum_metric_008,
  SUM(CASE
    WHEN metric_009 > 900.0 THEN metric_009 * 2.00
    WHEN metric_009 > 800.0 THEN metric_009 * 1.90
    WHEN metric_009 > 700.0 THEN metric_009 * 1.80
    WHEN metric_009 > 600.0 THEN metric_009 * 1.70
    WHEN metric_009 > 500.0 THEN metric_009 * 1.60
    WHEN metric_009 > 400.0 THEN metric_009 * 1.50
    WHEN metric_009 > 300.0 THEN metric_009 * 1.40
    WHEN metric_009 > 200.0 THEN metric_009 * 1.30
    WHEN metric_009 > 100.0 THEN metric_009 * 1.20
    WHEN metric_009 > 0.0 THEN metric_009 * 1.10
    ELSE metric_009
  END) AS sum_metric_009,
  SUM(CASE
    WHEN metric_010 > 900.0 THEN metric_010 * 2.00
    WHEN metric_010 > 800.0 THEN metric_010 * 1.90
    WHEN metric_010 > 700.0 THEN metric_010 * 1.80
    WHEN metric_010 > 600.0 THEN metric_010 * 1.70
    WHEN metric_010 > 500.0 THEN metric_010 * 1.60
    WHEN metric_010 > 400.0 THEN metric_010 * 1.50
    WHEN metric_010 > 300.0 THEN metric_010 * 1.40
    WHEN metric_010 > 200.0 THEN metric_010 * 1.30
    WHEN metric_010 > 100.0 THEN metric_010 * 1.20
    WHEN metric_010 > 0.0 THEN metric_010 * 1.10
    ELSE metric_010
  END) AS sum_metric_010,
  SUM(CASE
    WHEN metric_011 > 900.0 THEN metric_011 * 2.00
    WHEN metric_011 > 800.0 THEN metric_011 * 1.90
    WHEN metric_011 > 700.0 THEN metric_011 * 1.80
    WHEN metric_011 > 600.0 THEN metric_011 * 1.70
    WHEN metric_011 > 500.0 THEN metric_011 * 1.60
    WHEN metric_011 > 400.0 THEN metric_011 * 1.50
    WHEN metric_011 > 300.0 THEN metric_011 * 1.40
    WHEN metric_011 > 200.0 THEN metric_011 * 1.30
    WHEN metric_011 > 100.0 THEN metric_011 * 1.20
    WHEN metric_011 > 0.0 THEN metric_011 * 1.10
    ELSE metric_011
  END) AS sum_metric_011,
  SUM(CASE
    WHEN metric_012 > 900.0 THEN metric_012 * 2.00
    WHEN metric_012 > 800.0 THEN metric_012 * 1.90
    WHEN metric_012 > 700.0 THEN metric_012 * 1.80
    WHEN metric_012 > 600.0 THEN metric_012 * 1.70
    WHEN metric_012 > 500.0 THEN metric_012 * 1.60
    WHEN metric_012 > 400.0 THEN metric_012 * 1.50
    WHEN metric_012 > 300.0 THEN metric_012 * 1.40
    WHEN metric_012 > 200.0 THEN metric_012 * 1.30
    WHEN metric_012 > 100.0 THEN metric_012 * 1.20
    WHEN metric_012 > 0.0 THEN metric_012 * 1.10
    ELSE metric_012
  END) AS sum_metric_012,
  COUNT(*) AS record_count
FROM TABLE(
  TUMBLE(TABLE _Raw01, DESCRIPTOR(event_time), INTERVAL '30' SECOND)
)
GROUP BY region, window_start, window_end, window_time;

_Rolling01 := SELECT
  deviceId,
  window_time,
  MAX(metric_001) AS max_metric_001,
  MAX(metric_002) AS max_metric_002,
  MAX(metric_003) AS max_metric_003,
  MAX(metric_004) AS max_metric_004,
  MAX(metric_005) AS max_metric_005,
  MAX(metric_006) AS max_metric_006,
  MAX(metric_007) AS max_metric_007,
  MAX(metric_008) AS max_metric_008,
  MAX(metric_009) AS max_metric_009,
  MAX(metric_010) AS max_metric_010,
  MAX(metric_011) AS max_metric_011,
  MAX(metric_012) AS max_metric_012
FROM TABLE(
  HOP(TABLE _Raw01, DESCRIPTOR(event_time), INTERVAL '1' MINUTE, INTERVAL '5' MINUTE)
)
GROUP BY deviceId, window_start, window_end, window_time;

/** Latest rolling maxima per device for domain 01. */
/*+query_by_all(deviceId) */
Latest01 := DISTINCT _Rolling01 ON deviceId ORDER BY window_time DESC;

_Alerts01 := SELECT region, window_end, sum_metric_001, record_count
FROM Metrics01 WHERE sum_metric_001 > 100000.0;

EXPORT _Alerts01 TO logger.alerts01;

/* ============================================================
   Query functions and subscription
   ============================================================ */

/** Returns the 30 second totals of domain 01 for a region and time range. */
MetricsByRegion(region STRING NOT NULL, fromTime TIMESTAMP NOT NULL, toTime TIMESTAMP NOT NULL) :=
SELECT * FROM Metrics01
WHERE region = :region AND :fromTime <= window_start AND :toTime > window_end
ORDER BY window_end DESC;

/** Returns the latest rolling maxima for one device of domain 01. */
LatestByDevice(deviceId STRING NOT NULL) :=
SELECT * FROM Latest01 WHERE deviceId = :deviceId;

/** The first domains side by side, one row per domain, region and window. */
/*+primary_key(domainId, region, window_end) */
RegionTotals :=
  SELECT '01' AS domainId, region, window_end, window_time,
         sum_metric_001, record_count
  FROM Metrics01;

/** Pushes alerts of domain 01 to subscribers. */
HighMetricAlert := SUBSCRIBE SELECT * FROM _Alerts01;
